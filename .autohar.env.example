# Copy this file to .autohar.env and fill in the planner backend you want.

# Default: OpenAI planner
OPENAI_API_KEY=your_openai_api_key_here
AUTOHAR_LLM_MODEL=gpt-5-mini

# Optional: use a local LM Studio server instead of OpenAI.
# If enabled, AUTOHAR_LLM_MODEL should match the model identifier exposed by LM Studio.
# AUTOHAR_LLM_API_KEY can be any non-empty placeholder if your local server does not require auth.
# AUTOHAR_LLM_BACKEND=lmstudio
# AUTOHAR_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LLM_API_KEY=lm-studio
# AUTOHAR_LLM_MODEL=local-model

# Optional: give each role its own direct backend / model settings.
# Supported role prefixes:
# - AUTOHAR_ORCHESTRATOR_*
# - AUTOHAR_MODEL_AGENT_*
# - AUTOHAR_AUGMENTATION_AGENT_*
# - AUTOHAR_DATA_AGENT_*
# - AUTOHAR_JUDGE_*
#
# Example:
# AUTOHAR_ORCHESTRATOR_BACKEND=lmstudio
# AUTOHAR_ORCHESTRATOR_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_ORCHESTRATOR_API_KEY=lm-studio
# AUTOHAR_ORCHESTRATOR_MODEL=local-orchestrator-model
#
# AUTOHAR_MODEL_AGENT_BACKEND=lmstudio
# AUTOHAR_MODEL_AGENT_MODEL=local-model-agent
