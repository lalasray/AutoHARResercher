# Copy this file to `.autohar.env` and keep only the setup you want.
#
# You do not need all sections at once.
# Pick one of:
# 1. Shared OpenAI model for all roles
# 2. Separate OpenAI models by role
# 3. Shared LM Studio model for all roles
# 4. Separate LM Studio models by role

########################################
# 1) Shared OpenAI model for all roles #
########################################

# OPENAI_API_KEY=your_openai_api_key_here
# AUTOHAR_OPENAI_MODEL=gpt-5-mini


#####################################################
# 2) Separate OpenAI role instances, same model     #
#####################################################

# OPENAI_API_KEY=your_openai_api_key_here
#
# AUTOHAR_OPENAI_ORCHESTRATOR_MODEL=gpt-5-mini
# AUTOHAR_OPENAI_MODEL_AGENT_MODEL=gpt-5-mini
# AUTOHAR_OPENAI_AUGMENTATION_AGENT_MODEL=gpt-5-mini
# AUTOHAR_OPENAI_DATA_AGENT_MODEL=gpt-5-mini
# AUTOHAR_OPENAI_JUDGE_MODEL=gpt-5-mini


########################################
# 3) Shared LM Studio model for all    #
########################################

# AUTOHAR_LLM_BACKEND=lmstudio
# AUTOHAR_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LLM_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_MODEL=your_lmstudio_model_id


########################################################
# 4) Separate LM Studio role instances, same model     #
########################################################

# AUTOHAR_LLM_BACKEND=lmstudio
# AUTOHAR_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LLM_API_KEY=lm-studio
#
# AUTOHAR_ORCHESTRATOR_BACKEND=lmstudio
# AUTOHAR_LMSTUDIO_ORCHESTRATOR_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LMSTUDIO_ORCHESTRATOR_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_ORCHESTRATOR_MODEL=local-orchestrator-model
#
# AUTOHAR_MODEL_AGENT_BACKEND=lmstudio
# AUTOHAR_LMSTUDIO_MODEL_AGENT_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LMSTUDIO_MODEL_AGENT_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_MODEL_AGENT_MODEL=local-model-agent
#
# AUTOHAR_AUGMENTATION_AGENT_BACKEND=lmstudio
# AUTOHAR_LMSTUDIO_AUGMENTATION_AGENT_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LMSTUDIO_AUGMENTATION_AGENT_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_AUGMENTATION_AGENT_MODEL=local-augmentation-agent
#
# AUTOHAR_DATA_AGENT_BACKEND=lmstudio
# AUTOHAR_LMSTUDIO_DATA_AGENT_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LMSTUDIO_DATA_AGENT_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_DATA_AGENT_MODEL=local-data-agent
#
# AUTOHAR_JUDGE_BACKEND=lmstudio
# AUTOHAR_LMSTUDIO_JUDGE_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LMSTUDIO_JUDGE_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_JUDGE_MODEL=local-judge-model


########################################
# Optional shared runtime settings      #
########################################

# AUTOHAR_ROUNDS=20
# AUTOHAR_MATERIALIZE_GIT=1
# AUTOHAR_AUTO_PUSH_NON_MAIN=0
# AUTOHAR_ALLOW_LLM_FALLBACK=true
