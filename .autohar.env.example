# Copy this file to `.autohar.env`

########################################
# LLM Backend Selection                #
########################################

# Option 1: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# AUTOHAR_OPENAI_MODEL=gpt-4o-mini

# Option 2: OpenCode local CLI
# AUTOHAR_LLM_BACKEND=opencode
# AUTOHAR_OPENCODE_BIN=/home/your-user/.opencode/bin/opencode
# AUTOHAR_OPENCODE_MODEL=qwen/qwen3-30b-a3b-2507
# AUTOHAR_OPENCODE_PURE=true
#
# Mission frontmatter can define:
# backend: auto|openai|opencode
# rounds: 20
# resume: true|false
# materialize_git: true|false
# auto_push_non_main: true|false
# never_stop: true|false
# time_budget: 300

########################################
# Autoresearch Loop Settings           #
########################################

# Time budget per experiment (seconds)
# AUTOHAR_TIME_BUDGET_SECONDS=300

# Never-stop mode
# AUTOHAR_NEVER_STOP=true


########################################
# Optional Settings                    #
########################################

# Judge thresholds
# AUTOHAR_JUDGE_PRIOR_BEST_DELTA=0.015
# AUTOHAR_JUDGE_RECENT_DELTA=0.01

# Sandbox
# AUTOHAR_SANDBOX_TIMEOUT=5
# AUTOHAR_SANDBOX_MODE=thread
