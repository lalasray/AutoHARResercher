# Copy this file to `.autohar.env`

########################################
# LLM Backend Selection                #
########################################

# Option 1: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# AUTOHAR_OPENAI_MODEL=gpt-4o-mini

# Option 2: LM Studio (local)
# AUTOHAR_LLM_BACKEND=lmstudio
# AUTOHAR_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LLM_API_KEY=lm-studio
# AUTOHAR_LMSTUDIO_MODEL=lmstudio/qwen/qwen3-coder-30b
# AUTOHAR_CHAT_RESPONSE_FORMAT=text
# AUTOHAR_CHAT_MAX_TOKENS=2048
# AUTOHAR_COMPACT_PROMPT_CONTEXT=false
# AUTOHAR_MISSION_FILE=missions/example_mission.md

# Option 3: OpenCode local CLI
# AUTOHAR_LLM_BACKEND=opencode
# AUTOHAR_OPENCODE_BIN=/home/your-user/.opencode/bin/opencode
# AUTOHAR_OPENCODE_MODEL=lmstudio/qwen/qwen3-30b-a3b-2507
# AUTOHAR_OPENCODE_PURE=true
#
# Mission frontmatter can define:
# backend: auto|openai|opencode|lmstudio|heuristic
# rounds: 20
# resume: true|false
# materialize_git: true|false
# auto_push_non_main: true|false
# never_stop: true|false
# time_budget: 300

# Option 4: Heuristic (no LLM)
# AUTOHAR_LLM_BACKEND=heuristic
# AUTOHAR_ALLOW_LLM_FALLBACK=true


########################################
# Autoresearch Loop Settings           #
########################################

# Time budget per experiment (seconds)
# AUTOHAR_TIME_BUDGET_SECONDS=300

# Never-stop mode
# AUTOHAR_NEVER_STOP=true


########################################
# Optional Settings                    #
########################################

# Judge thresholds
# AUTOHAR_JUDGE_PRIOR_BEST_DELTA=0.015
# AUTOHAR_JUDGE_RECENT_DELTA=0.01

# Sandbox
# AUTOHAR_SANDBOX_TIMEOUT=5
# AUTOHAR_SANDBOX_MODE=thread
