# Copy this file to `.autohar.env` and keep only the setup you want.
#
# You do not need all sections at once.
# Pick one of:
# 1. OpenCode Git-based (NO API KEY - uses OpenCode CLI) [RECOMMENDED]
# 2. Shared OpenAI model for all roles
# 3. LM Studio model for all roles
# 4. Heuristic fallback (NO LLM at all)

########################################
# 1) OpenCode Git-based (RECOMMENDED) #
#    No API key required!              #
########################################

AUTOHAR_LLM_BACKEND=opencode

# Prerequisites:
# 1. Install OpenCode: https://opencode.ai
# 2. Configure OpenCode to work on this repo
# 3. In one terminal: ./run_opencode_agent.sh --watch
# 4. In another: ./run_autohar_opencode.sh --rounds 10


########################################
# 2) Shared OpenAI model for all roles #
########################################

# OPENAI_API_KEY=your_openai_api_key_here
# AUTOHAR_OPENAI_MODEL=gpt-4o-mini


#####################################################
# 3) Shared LM Studio model for all roles           #
#####################################################

# AUTOHAR_LLM_BACKEND=lmstudio
# AUTOHAR_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AUTOHAR_LLM_API_KEY=lm-studio


########################################
# 4) Heuristic fallback (NO LLM)       #
########################################

# AUTOHAR_LLM_BACKEND=heuristic
# AUTOHAR_ALLOW_LLM_FALLBACK=true


########################################
# Optional shared runtime settings      #
########################################

# AUTOHAR_ROUNDS=20
# AUTOHAR_MATERIALIZE_GIT=1
# AUTOHAR_AUTO_PUSH_NON_MAIN=0
# AUTOHAR_ALLOW_LLM_FALLBACK=true

########################################
# Optional sandbox settings             #
########################################

# AUTOHAR_SANDBOX_TIMEOUT=5
# AUTOHAR_SANDBOX_MODE=thread  # or "subprocess"

########################################
# Optional judge threshold settings     #
########################################

# AUTOHAR_JUDGE_PRIOR_BEST_DELTA=0.015
# AUTOHAR_JUDGE_RECENT_DELTA=0.01
# AUTOHAR_JUDGE_RELAXED_PRIOR_BEST_DELTA=0.03
# AUTOHAR_JUDGE_RELAXED_RECENT_DELTA=0.02
